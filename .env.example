PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/velvetstream
PGSSL=disable

# Generate a strong random value (32+ chars)
JWT_SECRET=replace-with-a-long-random-secret

# S3-compatible storage (Cloudflare R2, Backblaze B2 S3, MinIO, etc.)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=velvetstream-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_VIDEO_BYTES=536870912

# Used only by: npm run admin:create
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
